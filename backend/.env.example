# Copy this file to .env and fill in your own values.
# ------------------------------------------------------------
# EC2 PRODUCTION values are shown. For local dev, see comments.
# ------------------------------------------------------------

# production = hides internal error details in API responses.
# PM2 ecosystem.config.js also forces NODE_ENV=production on EC2.
NODE_ENV=production

# Port the Express API listens on.
PORT=5000

# Network interface Express binds to.
# 127.0.0.1 = only Nginx (on the same machine) can reach it — use this on EC2.
# 0.0.0.0   = all interfaces — use this for local development only.
HOST=127.0.0.1

# MongoDB Atlas connection string (replace USERNAME, PASSWORD, and cluster host).
# Must include the database name (/studentdb) before the query string.
#
# Option A — SRV URI (shorter, requires working SRV DNS lookups):
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/studentdb?retryWrites=true&w=majority&appName=Cluster0
#
# Option B — standard non-SRV URI (use this if Node reports
# "querySrv ECONNREFUSED", or if the network blocks SRV DNS queries).
# Get the shard hosts and replica set name with:
#   nslookup -type=SRV _mongodb._tcp.CLUSTER_HOST
#   nslookup -type=TXT CLUSTER_HOST
# MONGODB_URI=mongodb://USERNAME:PASSWORD@ac-xxxxx-shard-00-00.xxxxx.mongodb.net:27017,ac-xxxxx-shard-00-01.xxxxx.mongodb.net:27017,ac-xxxxx-shard-00-02.xxxxx.mongodb.net:27017/studentdb?ssl=true&authSource=admin&retryWrites=true&w=majority&replicaSet=atlas-xxxxx-shard-0

# Optional — automatic fallback. If MONGODB_URI is an SRV URI and its DNS lookup
# fails, config/db.js retries once with this non-SRV URI.
# MONGODB_URI_FALLBACK=mongodb://USERNAME:PASSWORD@ac-xxxxx-shard-00-00.xxxxx.mongodb.net:27017,ac-xxxxx-shard-00-01.xxxxx.mongodb.net:27017,ac-xxxxx-shard-00-02.xxxxx.mongodb.net:27017/studentdb?ssl=true&authSource=admin&retryWrites=true&w=majority&replicaSet=atlas-xxxxx-shard-0

# Optional — DNS servers Node's c-ares resolver should use for SRV lookups.
# Only needed when the system DNS works (nslookup) but Node cannot resolve SRV.
# MONGODB_DNS_SERVERS=1.1.1.1,1.0.0.1

# Optional — used by scripts/diagnose-db.js to generate a non-SRV URI.
# MONGODB_SHARD_HOSTS=ac-xxxxx-shard-00-00.xxxxx.mongodb.net,ac-xxxxx-shard-00-01.xxxxx.mongodb.net,ac-xxxxx-shard-00-02.xxxxx.mongodb.net
# MONGODB_REPLICA_SET=atlas-xxxxx-shard-0

# Local development alternative (MongoDB running on localhost):
# HOST=0.0.0.0
# MONGODB_URI=mongodb://127.0.0.1:27017/studentdb

# Optional: comma-separated browser origins allowed by CORS.
# Leave unset when Nginx serves the frontend on the same origin as /api.
# CLIENT_ORIGIN=https://yourdomain.com
